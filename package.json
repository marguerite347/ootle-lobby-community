{
  "name": "ootle-lobby-community",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "validate": "node scripts/build.mjs --check",
    "build": "node scripts/build.mjs",
    "setup:site": "npm --prefix creator-hub/hub ci",
    "build:site": "npm --prefix creator-hub/hub ci && npm --prefix creator-hub/hub run build && node scripts/prepare-site.mjs",
    "start:site": "node scripts/start-site.mjs"
  },
  "dependencies": {
    "express": "4.21.2"
  }
}
